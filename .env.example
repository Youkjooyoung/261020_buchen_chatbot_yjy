# 이 파일을 복사해서 .env 로 이름을 바꾸고, = 뒤에 본인 키를 넣으세요.
# .env 는 .gitignore 로 GitHub 업로드에서 제외됩니다. (이 예시 파일만 올라감)
# ⚠️ 이 파일에는 절대 실제 키를 넣지 마세요.

# Groq (무료) : https://console.groq.com/keys
GROQ_API_KEY=

# Claude (유료) : https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# 국가교통정보센터 ITS OpenAPI : https://www.its.go.kr/opendata/
ITS_API_KEY=
